# ============================================================================
# ATLAS Gym - Caddy (reverse proxy)
# ============================================================================
# Dos modos, según el .env (docs/DEPLOY.md, paso 2.1):
#  - Túnel de Cloudflare (producción): ATLAS_CADDY_SITIO=:80. Caddy sirve HTTP solo dentro del
#    servidor; Cloudflare pone el HTTPS y el tráfico entra por el contenedor cloudflared.
#  - Directo (ensayo del CI, o un servidor con 80/443 abiertos): ATLAS_CADDY_SITIO=<dominio>.
#    Caddy saca y renueva el certificado HTTPS solo (Let's Encrypt / ZeroSSL).
# ============================================================================

{
    servers {
        # IP real del visitante. Detrás del túnel todos los pedidos llegan desde cloudflared, así que
        # sin esto el límite de intentos de login bloquearía a todo el gimnasio a la vez.
        # CF-Connecting-IP solo se cree si el pedido viene de la red interna de Docker (cloudflared);
        # desde afuera ese header se ignora y no se puede falsificar.
        trusted_proxies static 172.16.0.0/12
        client_ip_headers CF-Connecting-IP
    }
}

{$ATLAS_CADDY_SITIO:localhost} {
    encode zstd gzip

    # Cabeceras de seguridad HTTP
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # API directa de Spring Boot. {client_ip} es la IP real (ver arriba); el back la usa para el
    # límite de intentos de login (server.forward-headers-strategy=framework).
    handle /api/* {
        reverse_proxy backend:8080 {
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
        }
    }

    # Aplicación web Next.js (y proxy same-origin /backend-api/*, que reenvía X-Forwarded-For al back)
    handle {
        reverse_proxy frontend:3000 {
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
        }
    }
}
