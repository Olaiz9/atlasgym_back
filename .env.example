# ============================================================================
# ATLAS Gym - Variables de Entorno de Producción (.env.example)
# Copiar a .env y reemplazar TODOS los valores de ejemplo por secretos reales.
# NUNCA commitear el archivo .env al repositorio Git.
# ============================================================================

# Zona horaria del gimnasio (evita desfasajes de medianoche en vencimientos día 10 y check-ins nocturnos)
TZ=America/Argentina/Buenos_Aires

# Ruta relativa o absoluta al repositorio Frontend para docker compose build
# En VPS con carpetas hermanas usar ../atlasgym_front
ATLAS_FRONT_DIR=../atlasgym_front

# Base de datos MySQL 8.0
MYSQL_DATABASE=atlas_gym
DB_USER=atlas_app
DB_PASSWORD=CAMBIAR_CLAVE_DB_SEGURA_2026
MYSQL_ROOT_PASSWORD=CAMBIAR_CLAVE_ROOT_MYSQL_2026
DB_HOST_PORT=3307

# Seguridad JWT (generar con: openssl rand -hex 32)
ATLAS_JWT_SECRET=REEMPLAZAR_CON_64_CARACTERES_HEX_ALEATORIOS_MINIMO_256_BITS_AQUI
ATLAS_JWT_EXPIRATION=86400000

# Credenciales nominales de administración (2 cuentas independientes para los 2 hermanos dueños)
ATLAS_ADMIN_EMAIL=bruno@atlasgym.com.ar
ATLAS_ADMIN_PASSWORD=CAMBIAR_CLAVE_DUENO_1_2026
ATLAS_ADMIN_NOMBRE=Bruno (Dueño)
ATLAS_ADMIN2_EMAIL=hermano@atlasgym.com.ar
ATLAS_ADMIN2_PASSWORD=CAMBIAR_CLAVE_DUENO_2_2026
ATLAS_ADMIN2_NOMBRE=Co-Titular (Dueño)

# Secreto compartido de la tablet del Tótem (opcional pero recomendado en producción)
ATLAS_TOTEM_SECRET=CAMBIAR_SECRETO_TABLET_TOTEM_2026

# URLs y orígenes CORS permitidos (soporta lista separada por comas y patrones LAN/subdominio)
ATLAS_CORS_ALLOWED_ORIGIN=http://localhost:3000,http://192.168.*.*:3000
# Usar /backend-api (proxy same-origin dinámico: funciona en celulares por Wi-Fi LAN, tablet Tótem y dominios HTTPS sin exponer :8080)
NEXT_PUBLIC_API_URL=/backend-api
BACKEND_INTERNAL_URL=http://backend:8080

# Puertos publicados en el host
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
