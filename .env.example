# ============================================================================
# ATLAS Gym - Variables de Entorno de Producción (.env.example)
# Copiar a .env y reemplazar TODOS los valores de ejemplo por secretos reales.
# NUNCA commitear el archivo .env al repositorio Git.
# ============================================================================

# Zona horaria del gimnasio (evita desfasajes de medianoche en vencimientos día 10 y check-ins nocturnos)
TZ=America/Argentina/Buenos_Aires

# Ruta relativa o absoluta al repositorio Frontend para docker compose build
# En VPS con carpetas hermanas usar ../atlasgym_front
ATLAS_FRONT_DIR=../atlasgym_front

# Base de datos MySQL 8.0
MYSQL_DATABASE=atlas_gym
DB_USER=atlas_app
DB_PASSWORD=CAMBIAR_CLAVE_DB_SEGURA_2026
MYSQL_ROOT_PASSWORD=CAMBIAR_CLAVE_ROOT_MYSQL_2026
DB_HOST_PORT=3307

# Seguridad JWT (generar con: openssl rand -hex 32)
ATLAS_JWT_SECRET=REEMPLAZAR_CON_64_CARACTERES_HEX_ALEATORIOS_MINIMO_256_BITS_AQUI
ATLAS_JWT_EXPIRATION=86400000

# Credenciales nominales de administración (2 cuentas independientes para los 2 hermanos dueños)
# Alta inicial de los titulares: claves de 12+ caracteres. Si la cuenta ya existe no se modifica.
ATLAS_ADMIN_BOOTSTRAP_ENABLED=true
ATLAS_ADMIN_EMAIL=dueno1@atlasgym.com.ar
ATLAS_ADMIN_PASSWORD=CAMBIAR_CLAVE_DUENO_1_2026
ATLAS_ADMIN_NOMBRE=Titular 1
ATLAS_ADMIN2_EMAIL=dueno2@atlasgym.com.ar
ATLAS_ADMIN2_PASSWORD=CAMBIAR_CLAVE_DUENO_2_2026
ATLAS_ADMIN2_NOMBRE=Titular 2

# Clave de la tablet del Tótem. OBLIGATORIA en producción: si queda vacía, cualquiera puede marcar
# asistencias contra la API. Se escribe una sola vez en la tablet al vincularla. Generar con: openssl rand -hex 24
ATLAS_TOTEM_SECRET=CAMBIAR_SECRETO_TABLET_TOTEM_2026
# PIN de 4 dígitos que pide la pantalla /totem para habilitar la tablet (traba liviana: el PIN
# viaja dentro de la página; la protección real es ATLAS_TOTEM_SECRET). Vacío = 1234 de fábrica.
ATLAS_TOTEM_PIN=
# Aviso "Tótem sin señal": la tablet avisa cada minuto que anda. Si deja de avisar más de
# ATLAS_TOTEM_ALERTA_MINUTOS dentro del horario de apertura, los titulares ven un cartel en la app.
# Fuera de horario no alarma. Formato HH:mm-HH:mm (puede cruzar la medianoche, ej. 18:00-02:00).
ATLAS_TOTEM_HORARIO=06:00-23:00
ATLAS_TOTEM_ALERTA_MINUTOS=5

# URLs y orígenes CORS permitidos (soporta lista separada por comas y patrones LAN/subdominio)
ATLAS_CORS_ALLOWED_ORIGIN=http://localhost:3000,http://192.168.*.*:3000,https://gym.atlas.com.ar
# Usar /backend-api (proxy same-origin dinámico: funciona en celulares por Wi-Fi LAN, tablet Tótem y dominios HTTPS sin exponer :8080)
NEXT_PUBLIC_API_URL=/backend-api
BACKEND_INTERNAL_URL=http://backend:8080

# Cómo entra el público (docs/DEPLOY.md, paso 2.1).
# Producción: túnel de Cloudflare. Caddy sirve HTTP solo dentro del servidor y Cloudflare pone el HTTPS.
COMPOSE_PROFILES=tunel
# Token del túnel: panel de Cloudflare > Zero Trust > Networks > Tunnels > el túnel > token
CLOUDFLARE_TUNNEL_TOKEN=CAMBIAR_TOKEN_DEL_TUNEL
ATLAS_CADDY_SITIO=:80
CADDY_BIND=127.0.0.1
# Sin túnel (servidor con 80/443 abiertos y certificado propio de Caddy): borrar COMPOSE_PROFILES y
# CLOUDFLARE_TUNNEL_TOKEN, poner ATLAS_CADDY_SITIO=<el dominio> y CADDY_BIND=0.0.0.0.

# Dominio del gimnasio, sin https:// (ej. gym.atlas.com.ar); localhost para pruebas locales
ATLAS_DOMAIN=localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Puertos publicados en el host
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# Techo de memoria por contenedor (pensado para un VPS de 4 GB). En un servidor de 2 GB bajar a
# MYSQL_MEM_LIMIT=640m, BACKEND_MEM_LIMIT=768m y FRONTEND_MEM_LIMIT=384m.
MYSQL_MEM_LIMIT=1g
BACKEND_MEM_LIMIT=1g
FRONTEND_MEM_LIMIT=768m
CADDY_MEM_LIMIT=256m

# Estrategia de Backups Offsite (resguardo ante falla física de SSD o ransomware)
# 1. Carpeta sincronizada externa (ej. Google Drive Desktop, OneDrive o NAS montado en host):
BACKUP_OFFSITE_DIR=
# 2. Remoto rclone opcional (ej. gdrive:atlasgym-backups o s3:atlasgym-backups):
RCLONE_REMOTE=
# Si RCLONE_REMOTE o BACKUP_OFFSITE_DIR estan configurados y la copia no llega, el backup termina con error.
# 3. Aviso diario a healthchecks.io (docs/DEPLOY.md, 7.2): ping si salio bien, <url>/fail si fallo.
BACKUP_PING_URL=
